{{ $image_tag := env "IMAGE_TAG" | default  (exec "../scripts/branded_image_tag.sh" (list) | trim) }}

deploy:
    GITHUB_REPOSITORY: it4change/helfa.social
    IMAGE_TAG: {{ $image_tag }}
    DOMAIN: helfa-social-staging.ocelot-social.it4c.org
    REDIRECT_DOMAINS: []
    NAMESPACE: helfa-social-staging
    RELEASE_NAME_OCELOT: helfa-social
    NEO4J_STORAGE: "5Gi"

ocelot:
    options:
        PRODUCTION_DB_CLEAN_ALLOW: "false"
        PUBLIC_REGISTRATION: "false"
        INVITE_REGISTRATION: "true"
        CATEGORIES_ACTIVE: "true"
        MAX_PINNED_POSTS: "1"
        BADGES_ENABLED: "false"
        NETWORK_NAME: "helfa.social"
        ASK_FOR_REAL_NAME: "true"
        REQUIRE_LOCATION: "true"
        MAX_GROUP_PINNED_POSTS: "1"
        API_KEYS_ENABLED: "true"
        API_KEYS_MAX_PER_USER: "5"
        SHOW_CONTENT_FILTER_HEADER_MENU: "true"
        SHOW_CONTENT_FILTER_MASONRY_GRID: "false"
        SHOW_GROUP_BUTTON_IN_HEADER: "true"
        # Contact identity. These used to live in branding/constants/emails.js; the runtime branding
        # schema deliberately does not carry them (they are e-mail/link config, not brand design), so
        # they are ENV now. Without them the backend falls back to the ocelot.social defaults.
        SUPPORT_EMAIL: "support@helfa.social"
        SUPPORT_LINK: "https://helfa.social/support"
        ORGANIZATION_LINK: "https://helfa.social/organization"
